{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "group-debug.html", "use": "@vercel/static" },
    { "src": "debug-live.html", "use": "@vercel/static" },
    { "src": "debug-bracket.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "keepy-uppy.js", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "public/assets/**", "use": "@vercel/static" },
    { "src": "data/**", "use": "@vercel/static" },
    { "src": "api/recaps.js", "use": "@vercel/node", "config": { "includeFiles": ["data/**"] } },
    { "src": "api/game-scores.js", "use": "@vercel/node" },
    { "src": "api/health.js", "use": "@vercel/node" },
    { "src": "api/highlights.js", "use": "@vercel/node" },
    { "src": "api/leaders.js", "use": "@vercel/node" },
    { "src": "api/playerstats.js", "use": "@vercel/node" },
    { "src": "api/scoreboard.js", "use": "@vercel/node" },
    { "src": "api/standings.js", "use": "@vercel/node" },
    { "src": "api/statistics.js", "use": "@vercel/node" },
    { "src": "api/subscribe.js", "use": "@vercel/node" },
    { "src": "api/summary.js", "use": "@vercel/node" },
    { "src": "api/wft-scores.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/group-debug", "dest": "/group-debug.html" },
    { "src": "/debug-live", "dest": "/debug-live.html" },
    { "src": "/debug-bracket", "dest": "/debug-bracket.html" },
    { "src": "/wheelie-fun/(.+)", "dest": "https://game-buddy-pl.vercel.app/games/wheelie-fun-turbo/$1" },
    { "src": "/wheelie-fun/?", "dest": "https://game-buddy-pl.vercel.app/games/wheelie-fun-turbo/" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
